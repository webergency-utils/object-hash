{
  "name": "@webergency-utils/object-hash",
  "version": "1.2.0",
  "type": "module",
  "sideEffects": false,
  "description": "A fast, deterministic object hashing and stringification library supporting cyrb64, MurmurHash3, and SHA-256 algorithms.",
  "author": "radixxko",
  "license": "MIT",
  "main": "dist/hash.cjs",
  "module": "dist/hash.js",
  "types": "dist/hash.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/hash.d.ts",
        "default": "./dist/hash.js"
      },
      "require": {
        "types": "./dist/hash.d.cts",
        "default": "./dist/hash.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "npm run build && vitest run",
    "fuzz": "npm run build && jazzer fuzz_hash.cjs",
    "coverage": "npm run build && vitest run --coverage",
    "clean": "rm -rf ./dist",
    "reset": "npm run clean && rm -rf node_modules package-lock.json && npm i",
    "build": "npm run clean && tsup",
    "commit": "node -e \"const version = require('./package.json').version.trim(); require('child_process').execSync('git add . && git commit -m \\\"Version ' + version + '\\\"');\"",
    "version": "npm run build && npm publish --access public && npm run commit && git push"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webergency-utils/object-hash.git"
  },
  "bugs": {
    "url": "https://github.com/webergency-utils/object-hash/issues"
  },
  "homepage": {
    "url": "https://github.com/webergency-utils/object-hash#readme"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jazzer.js/core": "^4.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.4.1",
    "tsup": "^9.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.18"
  }
}
